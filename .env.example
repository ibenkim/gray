# Copy this file to .env and fill in your key.
# Ghost reads these from the environment at startup (Electron main process via dotenv).
# After changing any of these values, restart the app (`npm run dev`).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Dev-only telemetry file storage. Never use TELEMETRY_STORAGE=file in production.
TELEMETRY_STORAGE=file
TELEMETRY_DEV_DIR=./development-data/telemetry
