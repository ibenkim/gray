# Copy this file to .env and fill in your key (optional for recording).
# Ghost reads these from the environment at startup (Electron main process via dotenv).
# After changing any of these values, restart the app (`npm run dev`).
#
# Without OPENAI_API_KEY, recording and local polish still work; Finish cannot
# extract a workflow until you set a real key and restart.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Dev telemetry file storage. Defaults to `file` in development even if unset.
# Never use TELEMETRY_STORAGE=file in a packaged / production build.
TELEMETRY_STORAGE=file
TELEMETRY_DEV_DIR=./development-data/telemetry
